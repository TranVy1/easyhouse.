# Backup EasyHouse tai /home len Google Drive da ma hoa.
# File nay chua thong tin van hanh, khong duoc commit.
RCLONE_REMOTE=gdrive-crypt:easyhouse-production

POSTGRES_CONTAINER=easyhouse-postgres
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=postgres

# Ban sao tam tai may chu; source.tar.gz tu dong bo qua thu muc nay.
LOCAL_BACKUP_DIR=/home/backups
LOCAL_RETENTION_DAYS=14
REMOTE_RETENTION_DAYS=30
