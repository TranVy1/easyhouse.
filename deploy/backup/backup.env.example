# Copy thanh backup.env va chmod 600. File backup.env khong duoc commit.
# Tao crypt remote bang rclone theo deploy/backup/README.md, sau do dung vi du nay.
RCLONE_REMOTE=gdrive-crypt:easyhouse-production

# Neu container/database khac, thay tai day.
POSTGRES_CONTAINER=easyhouse-postgres
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=postgres

# Noi luu tam tren VPS va chinh sach giu ban backup.
LOCAL_BACKUP_DIR=/opt/easyhouse/backups
LOCAL_RETENTION_DAYS=14
REMOTE_RETENTION_DAYS=30
