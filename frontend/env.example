# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here
NODE_ENV=development
# File Upload (Optional)
NEXT_PUBLIC_CLOUD_NAME=
NEXT_PUBLIC_UPLOAD_PRESET=
# Chat realtime — WebSocket nối THẲNG tới backend.
# Rewrite của Next.js chỉ proxy HTTP, không nâng cấp được kết nối WebSocket,
# nên biến này phải trỏ trực tiếp tới backend (không đi qua /api).
#   Dev (chạy trực tiếp): ws://localhost:8080/ws
#   Dev (docker-compose): ws://localhost:8082/ws
#   Production:           wss://easyhouse.site/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
